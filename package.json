{
  "name": "robert",
  "version": "1.0.0",
  "description": "Robert",
  "main": "server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "setup": "npm install && npm install --prefix client",
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run server\" \"npm run client\"",
    "server": "nodemon --ignore client server.js",
    "client": "npm start --prefix client",
    "build": "npm run build --prefix client",
    "cf:dev": "wrangler dev",
    "start": "node server.js",
    "seed": "node scripts/seed.js"
  },
  "keywords": [],
  "author": "Hannah Wenger",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.9.2"
  }
}
